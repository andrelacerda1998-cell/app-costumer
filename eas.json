{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "preview2": {
      "android": {
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "preview3": {
      "developmentClient": true,
      "env": {
        "APP_ENV": "preview"
      }
    },
    "preview4": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production"
      }
    },
    "device-test": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEV_API_DOMAIN": "app.piquetapp.com",
        "EXPO_PUBLIC_DEV_API_PROTOCOL": "https://"
      }
    }
  }
}
