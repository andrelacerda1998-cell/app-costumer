{
  "name": "piquet-client",
  "main": "expo-router/entry",
  "version": "2026.8.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "prebuild:clean": "rm -rf android ios",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build-local:ios:production": "APP_ENV=production yarn prebuild:ios && open ios/Piquet.xcworkspace",
    "build-local:ios:preview": "APP_ENV=preview yarn prebuild:ios && open ios/Piquet.xcworkspace",
    "build-local:android": "yarn prebuild:android && cd android && ./gradlew clean && ./gradlew assembleRelease && cd .. && open android/app/build/outputs/apk/release",
    "build-local:android:production": "APP_ENV=production yarn build-local:android",
    "build-local:android:preview": "APP_ENV=preview yarn build-local:android",
    "build-local:android:development": "APP_ENV=development yarn build-local:android",
    "build-local:android:bundle": "yarn prebuild:android && cd android && ./gradlew clean && ./gradlew bundleRelease && cd .. && open android/app/build/outputs/bundle/release",
    "eas-build-preview:ios": "eas build --platform ios --profile preview",
    "eas-build-preview:android": "eas build --platform android --profile preview",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.2.3",
    "@expo/react-native-action-sheet": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.4.1",
    "@sentry/react-native": "~7.2.0",
    "advanced-html-parser": "^1.1.0",
    "axios": "^1.16.0",
    "card-validator": "^10.0.0",
    "core-js": "^3.39.0",
    "expo": "^54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^24.2.3",
    "jwt-decode": "^4.0.0",
    "laravel-echo": "^1.16.1",
    "lodash": "4.18.0",
    "mixpanel-react-native": "^3.3.0",
    "nativewind": "^4.2.7",
    "pusher-js": "^8.4.0-rc2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.4.1",
    "react-native": "0.81.5",
    "react-native-background-timer": "^2.4.1",
    "react-native-click-outside": "0.1.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-maps": "1.20.1",
    "react-native-masked-text": "^1.12.5",
    "react-native-modal": "^13.0.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-otp-entry": "^1.8.4",
    "react-native-payment-icons": "^1.0.11",
    "react-native-reanimated": "~3.19.5",
    "react-native-rsa-native": "^2.0.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@bacons/apple-targets": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.10",
    "@types/react": "~19.1.0",
    "@types/react-native-background-timer": "^2.0.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "expo": "$expo"
  },
  "resolutions": {
    "form-data": ">=4.0.6",
    "axios": "^1.16.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated"
      ]
    }
  }
}
